#!/usr/bin/env python3
"""p — assistente de terminal que conhece seu sistema.

Modos:
  p "pergunta"           → tiro único, comando no clipboard
  p chat                 → chatbot interativo (auto-resume última sessão)
  p chat --new           → nova sessão
  p chat --session NOME  → sessão nomeada
  p sessions             → listar sessões salvas
"""

import subprocess, json, sys, os, re, shutil, readline
from datetime import datetime
from pathlib import Path

# ── Config ──────────────────────────────────────────────────
SERVER_URL = os.environ.get("PI_SERVER_URL", "http://localhost:8080")
SESSIONS_DIR = Path.home() / ".p_sessions"
BOLD = "\033[1m"
GREEN = "\033[1;32m"
YELLOW = "\033[1;33m"
CYAN = "\033[1;36m"
GRAY = "\033[90m"
RESET = "\033[0m"

TOOLS = {
    "download": ["wget", "curl", "aria2c", "axel"],
    "archive":  ["tar", "gzip", "bzip2", "xz", "7z", "unzip", "zip"],
    "transfer": ["git", "rsync", "scp", "sftp"],
    "text":     ["jq", "yq", "ripgrep", "rg", "fd", "bat", "fzf", "sed", "awk"],
    "system":   ["systemctl", "journalctl", "htop", "ncdu", "duf", "btop"],
    "net":      ["ss", "netstat", "nmap", "nc", "ping", "dig", "mtr"],
    "package":  ["apt", "dpkg", "snap", "flatpak", "pip", "npm"],
}

# ── Tool detection ──────────────────────────────────────────
def check_tools():
    found = {}
    for category, cmds in TOOLS.items():
        available = [c for c in cmds
                     if subprocess.run(["which", c], capture_output=True).returncode == 0]
        if available:
            found[category] = available
    return found

def get_system_info():
    lines = []
    try:
        r = subprocess.run(["lsb_release", "-ds"], capture_output=True, text=True)
        lines.append(f"OS: {r.stdout.strip()}")
    except Exception:
        pass
    lines.append(f"Shell: {os.environ.get('SHELL', '?')}")
    lines.append(f"User: {os.environ.get('USER', '?')}")
    try:
        r = subprocess.run(["pwd"], capture_output=True, text=True)
        lines.append(f"Dir: {r.stdout.strip()}")
    except Exception:
        pass
    return "\n".join(lines)

# ── LLM ─────────────────────────────────────────────────────
def ask_llm(messages, max_tokens=250, temperature=0.3):
    """Send messages (list of {role, content}) to llama-server."""
    payload = {
        "messages": messages,
        "max_tokens": max_tokens,
        "temperature": temperature,
        "stream": False,
    }
    try:
        r = subprocess.run(
            ["curl", "-s", f"{SERVER_URL}/v1/chat/completions",
             "-H", "Content-Type: application/json",
             "-d", json.dumps(payload)],
            capture_output=True, text=True, timeout=60,
        )
        d = json.loads(r.stdout)
        return d["choices"][0]["message"]["content"]
    except Exception as e:
        return f"Erro: {e}"

# ── Clipboard ───────────────────────────────────────────────
def find_clipboard_tool():
    for tool in ["xclip", "wl-copy", "xsel"]:
        if shutil.which(tool):
            return tool
    return None

def copy_to_clipboard(text):
    tool = find_clipboard_tool()
    if tool in ("xclip", "xsel"):
        try:
            if tool == "xclip":
                result = subprocess.run(["xclip", "-selection", "clipboard"],
                               input=text, text=True, timeout=3,
                               stderr=subprocess.DEVNULL)
            else:
                result = subprocess.run(["xsel", "-ib"], input=text, text=True, timeout=3,
                               stderr=subprocess.DEVNULL)
            if result.returncode == 0:
                return tool
        except Exception:
            pass
    elif tool == "wl-copy":
        try:
            result = subprocess.run(["wl-copy"], input=text, text=True, timeout=3,
                           stderr=subprocess.DEVNULL)
            if result.returncode == 0:
                return tool
        except Exception:
            pass
    # Fallback: OSC 52
    encoded = text.strip().encode().hex()
    sys.stdout.write(f"\033]52;c;{encoded}\a")
    sys.stdout.flush()
    return "OSC 52"

def extract_commands(text):
    matches = re.findall(r'```(?:bash|sh)?\s*\n(.*?)\n```', text, re.DOTALL)
    if not matches:
        matches = re.findall(r'`([^`]+)`', text)
    return [m.strip() for m in matches]

# ── Sessions ────────────────────────────────────────────────
def _session_path(name):
    """Return file path for a named session."""
    SESSIONS_DIR.mkdir(parents=True, exist_ok=True)
    safe = re.sub(r'[^a-zA-Z0-9_-]', '_', name)
    return SESSIONS_DIR / f"{safe}.json"

def _last_session_path():
    """Return path to the most recently modified session file."""
    SESSIONS_DIR.mkdir(parents=True, exist_ok=True)
    files = sorted(SESSIONS_DIR.glob("*.json"), key=lambda f: f.stat().st_mtime, reverse=True)
    return files[0] if files else None

def save_session(name, messages, preview=""):
    """Save session to disk."""
    path = _session_path(name)
    data = {
        "name": name,
        "updated": datetime.now().isoformat(),
        "preview": preview[:100],
        "message_count": len(messages),
        "messages": messages,
    }
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2))

def load_session(name):
    """Load a session from disk. Returns (messages, metadata) or (None, None)."""
    path = _session_path(name) if name else _last_session_path()
    if not path or not path.exists():
        return None, None
    try:
        data = json.loads(path.read_text())
        return data.get("messages", []), data
    except Exception:
        return None, None

def list_sessions():
    """Return list of session metadata dicts."""
    SESSIONS_DIR.mkdir(parents=True, exist_ok=True)
    sessions = []
    for f in sorted(SESSIONS_DIR.glob("*.json"), key=lambda f: f.stat().st_mtime, reverse=True):
        try:
            data = json.loads(f.read_text())
            sessions.append({
                "name": data.get("name", f.stem),
                "updated": data.get("updated", "?"),
                "preview": data.get("preview", ""),
                "message_count": data.get("message_count", 0),
            })
        except Exception:
            pass
    return sessions

def delete_session(name):
    path = _session_path(name)
    if path.exists():
        path.unlink()
        return True
    return False

# ── Modo tiro único ─────────────────────────────────────────
def oneshot(query, force_copy=False):
    tools = check_tools()
    sysinfo = get_system_info()

    tool_lines = [f"  {cat}: {', '.join(cmds)}" for cat, cmds in tools.items()]

    system_prompt = f"""Voce eh o pi, um assistente de terminal Linux direto e pratico.

SISTEMA DO USUARIO:
{sysinfo}

FERRAMENTAS DISPONIVEIS:
{chr(10).join(tool_lines)}

Regras:
- Responda em portugues, de forma direta.
- Mostre APENAS o comando necessario, sem explicacoes longas.
- Priorize ferramentas JA INSTALADAS no sistema.
- Se houver multiplas opcoes, mostre a mais simples.
- Se faltar ferramenta ideal, sugira instalar com apt.
- Coloque SEMPRE o comando final dentro de ```bash.
- No maximo 2 linhas de contexto + o comando."""

    print(f"\n🤖 {BOLD}pi > {RESET}", end="", flush=True)
    answer = ask_llm([
        {"role": "system", "content": system_prompt},
        {"role": "user", "content": query},
    ])
    print(answer)

    commands = extract_commands(answer)
    if commands:
        print("\n" + "─" * 50)
        for i, cmd in enumerate(commands):
            if cmd.startswith("#") or len(cmd) < 3:
                continue
            if len(commands) > 1:
                print(f"{YELLOW}📋 [{i+1}]{RESET} {GREEN}{cmd}{RESET}")
            else:
                print(f"{YELLOW}📋 Comando:{RESET} {GREEN}{cmd}{RESET}")
            if i == 0 or force_copy:
                method = copy_to_clipboard(cmd)
                print(f"   {GRAY}✓ copiado via {method} — Ctrl+Shift+V para colar{RESET}")
                break
        print("─" * 50)

# ── Modo chat ───────────────────────────────────────────────
def chat_mode(session_name=None, force_new=False):
    """Chatbot interativo com salvamento automático de sessão."""
    sysinfo = get_system_info()

    system_prompt = f"""Voce eh o pi, um assistente de terminal Linux amigavel e prestativo.

SISTEMA DO USUARIO:
{sysinfo}

Voce esta rodando em modo chat interativo. Seja conversacional, responda em portugues.
Se o usuario pedir comandos de terminal, coloque-os em ```bash.
Seja direto mas nao robotico — use emojis ocasionalmente, mantenha um tom leve."""

    # ── Resolver sessão ──
    if force_new or session_name:
        name = session_name or datetime.now().strftime("%Y%m%d-%H%M%S")
        messages = [{"role": "system", "content": system_prompt}]
        resumed = False
    else:
        # Auto-resume última sessão
        existing, meta = load_session(None)
        if existing:
            messages = existing
            name = meta.get("name", "default")
            # Atualiza system prompt com info fresca do sistema
            if messages and messages[0]["role"] == "system":
                messages[0]["content"] = system_prompt
            resumed = True
        else:
            name = datetime.now().strftime("%Y%m%d-%H%M%S")
            messages = [{"role": "system", "content": system_prompt}]
            resumed = False

    last_answer = ""
    last_user_msg = ""

    # ── Banner ──
    if resumed:
        msg_count = len([m for m in messages if m["role"] != "system"])
        print(f"\n{CYAN}{BOLD}🐍 p chat{RESET} {GRAY}[{name}]{RESET} — {GRAY}{msg_count} msgs salvas{RESET}")
    else:
        print(f"\n{CYAN}{BOLD}🐍 p chat{RESET} {GRAY}[{name}]{RESET} — nova sessão")
    print(f"{GRAY}Comandos:{RESET} /bye /clear /system /copy /save /sessions /help\n")

    # ── Loop principal ──
    while True:
        try:
            user_input = input(f"{GREEN}🧑 > {RESET}").strip()
        except (EOFError, KeyboardInterrupt):
            print(f"\n{GRAY}💾 Salvando... 👋 Até mais!{RESET}")
            save_session(name, messages, preview=last_user_msg or "(vazia)")
            break

        if not user_input:
            continue

        # ── Comandos internos ──
        if user_input.startswith("/"):
            cmd = user_input[1:].lower().split()[0]
            arg = user_input[len(cmd)+1:].strip()

            if cmd in ("bye", "exit", "quit", "sair"):
                save_session(name, messages, preview=last_user_msg or "(vazia)")
                print(f"{GRAY}💾 Sessão '{name}' salva. 👋 Até mais!{RESET}")
                break

            elif cmd == "clear":
                messages = [{"role": "system", "content": system_prompt}]
                last_answer = ""
                last_user_msg = ""
                save_session(name, messages)
                print(f"{GRAY}🧹 Histórico limpo e salvo.{RESET}")
                continue

            elif cmd == "system":
                print(f"{GRAY}--- Sistema ---\n{sysinfo}\n--- Sessão: {name} ({len(messages)} msgs) ---{RESET}")
                continue

            elif cmd == "copy" and last_answer:
                method = copy_to_clipboard(last_answer)
                print(f"{GRAY}✓ Última resposta copiada via {method}{RESET}")
                continue

            elif cmd == "save":
                save_session(name, messages, preview=last_user_msg or "(vazia)")
                print(f"{GRAY}💾 Sessão '{name}' salva ({len(messages)} msgs).{RESET}")
                continue

            elif cmd == "sessions":
                sessions = list_sessions()
                if sessions:
                    print(f"\n{GRAY}{'SESSÃO':<25} {'MSGS':<6} {'ATUALIZADA':<20} PREVIEW")
                    print(f"{'─'*25} {'─'*6} {'─'*20} {'─'*30}{RESET}")
                    for s in sessions[:10]:
                        marker = f"{GREEN}▶{RESET} " if s["name"] == name else "  "
                        print(f"{marker}{s['name']:<23} {s['message_count']:<6} "
                              f"{s['updated'][:19]:<20} {s['preview'][:40]}{RESET}")
                else:
                    print(f"{GRAY}Nenhuma sessão salva.{RESET}")
                continue

            elif cmd == "help":
                print(f"{GRAY}/bye sair  /clear limpar  /system info  /copy copiar  /save salvar  /sessions listar  /help ajuda{RESET}")
                continue

            else:
                print(f"{GRAY}Comando desconhecido: /{cmd}  (use /help){RESET}")
                continue

        # ── Enviar para LLM ──
        last_user_msg = user_input
        messages.append({"role": "user", "content": user_input})
        print(f"{BOLD}🤖 > {RESET}", end="", flush=True)

        answer = ask_llm(messages, max_tokens=4096, temperature=0.7)
        print(answer)
        print()

        messages.append({"role": "assistant", "content": answer})
        last_answer = answer

        # Auto-save a cada troca
        save_session(name, messages, preview=user_input[:80])

        # Segurança: trim só acima de 500 mensagens
        if len(messages) > 501:
            messages = [messages[0]] + messages[-400:]

# ── Main ────────────────────────────────────────────────────
def main():
    args = sys.argv[1:]

    if not args:
        print("""Uso:
  p "sua pergunta"         tiro único, comando no clipboard
  p -c "comando"           força cópia de múltiplos comandos
  p chat                   chatbot (auto-resume última sessão)
  p chat --new             nova sessão
  p chat --session NOME    sessão nomeada
  p sessions               listar sessões salvas
  p sessions --delete NOME deletar sessão
  p help                   esta mensagem""")
        sys.exit(0)

    if args[0] in ("help", "--help", "-h"):
        print("""Uso:
  p "sua pergunta"         tiro único, comando no clipboard
  p -c "comando"           força cópia de múltiplos comandos
  p chat                   chatbot interativo (/bye para sair)
  p chat --new             nova sessão (não resume)
  p chat --session NOME    sessão nomeada
  p sessions               listar sessões
  p sessions --delete NOME deletar uma sessão

Exemplos:
  p "baixar arquivo grande com retomada"
  p "listar processos que mais consomem RAM"
  p chat
  p chat --session "python-study"
  p sessions""")
        sys.exit(0)

    # ── p sessions ──
    if args[0] == "sessions":
        if len(args) >= 3 and args[1] == "--delete":
            name = args[2]
            if delete_session(name):
                print(f"🗑️  Sessão '{name}' deletada.")
            else:
                print(f"Sessão '{name}' não encontrada.")
        else:
            sessions = list_sessions()
            if sessions:
                print(f"\n{GRAY}{'SESSÃO':<25} {'MSGS':<6} {'ATUALIZADA':<20} PREVIEW")
                print(f"{'─'*25} {'─'*6} {'─'*20} {'─'*30}{RESET}")
                for s in sessions:
                    label = s["name"]
                    print(f"{label:<25} {s['message_count']:<6} "
                          f"{s['updated'][:19]:<20} {s['preview'][:40]}{RESET}")
                print()
            else:
                print("Nenhuma sessão salva em ~/.pi_sessions/")
        return

    # ── p chat ──
    if args[0] == "chat":
        force_new = False
        session_name = None

        rest = args[1:]
        i = 0
        while i < len(rest):
            if rest[i] == "--new":
                force_new = True
            elif rest[i] == "--session" and i + 1 < len(rest):
                session_name = rest[i + 1]
                i += 1
            else:
                session_name = rest[i]  # p chat nome-da-sessao
            i += 1

        chat_mode(session_name=session_name, force_new=force_new)
        return

    # ── Modo tiro único ──
    force_copy = False
    if args[0] == "-c":
        force_copy = True
        args = args[1:]

    if not args:
        print("Uso: p [-c] \"sua pergunta\"")
        sys.exit(1)

    query = " ".join(args)
    oneshot(query, force_copy)

if __name__ == "__main__":
    main()
